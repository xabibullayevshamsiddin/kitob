APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# /system/setup uchun maxfiy token (kamida 16 belgi). Bo'sh qoldirilsa endpoint o'chiq.
SETUP_TOKEN=
PWA_ENABLED=true
WEBRTC_TURN_URLS=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp
WEBRTC_TURN_USERNAME=openrelayproject
WEBRTC_TURN_CREDENTIAL=openrelayproject

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

AI_ENABLED=true
AI_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
AI_EMBEDDING_PROVIDER=gemini
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest
AI_DAILY_LIMIT_PER_USER=10
AI_DAILY_LIMIT_PER_ADMIN=50
AI_MINUTE_THROTTLE=6
AI_MAX_QUESTION_CHARS=500
AI_MAX_CONTEXT_CHUNKS=6
AI_MAX_OUTPUT_TOKENS=700
AI_HISTORY_TURNS=6
AI_MIN_SIMILARITY=0.22
AI_MIN_FULLTEXT_SCORE=0.12

# OCR (Skanerlangan PDF fayllarni o'qish)
AI_OCR_ENABLED=true
TESSERACT_BIN=tesseract
PDFTOPPM_BIN=pdftoppm
AI_OCR_LANGUAGES=uzb+rus+eng
AI_OCR_DPI=150
AI_OCR_TIMEOUT_SECONDS=300

# Fon (Queue) orqali indekslash
AI_QUEUE_INDEXING=false
AI_QUEUE_CONNECTION=sync
AI_QUEUE_NAME=default
AI_INDEX_LOCK_SECONDS=900

# Telegram Integratsiyasi
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_MINI_APP_URL=
TELEGRAM_PAYMENTS_ENABLED=false
AUTH_EMAIL_REGISTRATION_ENABLED=true
